{
  "entities": {
    "Enquiry": {
      "title": "Enquiry",
      "description": "User enquiry for real estate plots",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "adminResponse": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "subject", "message", "userId", "status", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "Registered user profile",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "Visit": {
      "title": "Visit",
      "description": "Site visit request",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "projectId": { "type": "string" },
        "projectTitle": { "type": "string" },
        "preferredDate": { "type": "string", "format": "date" },
        "preferredTime": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "adminNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "projectId", "projectTitle", "preferredDate", "userId", "status", "createdAt"]
    }
  },
  "firestore": {
    "enquiries/{enquiryId}": {
      "schema": "Enquiry",
      "description": "Collection of user enquiries"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "visits/{visitId}": {
      "schema": "Visit",
      "description": "Site visit requests"
    }
  }
}
