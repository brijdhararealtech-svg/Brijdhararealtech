rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return isVerified() && request.auth.token.email == 'brijdhararealtech@gmail.com'; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profiles
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['email', 'createdAt']) 
          && (data.keys().size() >= 2 && data.keys().size() <= 4)
          && data.email is string && data.email.size() <= 255
          && data.createdAt == request.time;
      }
      
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isVerified() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isVerified() && request.auth.uid == userId 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])
        && incoming().email == existing().email;
    }

    // Enquiries
    match /enquiries/{enquiryId} {
      function isValidEnquiry(data) {
        return data.keys().hasAll(['name', 'phone', 'subject', 'message', 'userId', 'status', 'createdAt'])
          && (data.keys().size() == 7 || (data.keys().size() == 8 && data.keys().hasAll(['adminResponse'])))
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 20
          && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200
          && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
          && data.status in ['pending', 'accepted', 'declined']
          && data.userId == request.auth.uid
          && data.createdAt == request.time;
      }

      allow create: if isVerified() && isValidEnquiry(incoming()) && isValidId(enquiryId) && incoming().status == 'pending';
      allow list, get: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() 
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminResponse'])
        && incoming().status in ['pending', 'accepted', 'declined'];
    }

    // Site Visits
    match /visits/{visitId} {
      function isValidVisit(data) {
        return data.keys().hasAll(['name', 'phone', 'projectId', 'projectTitle', 'preferredDate', 'userId', 'status', 'createdAt'])
          && (data.keys().size() == 8 || (data.keys().size() == 9 && data.keys().hasAll(['adminNotes'])) || (data.keys().size() == 9 && data.keys().hasAll(['preferredTime'])))
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 20
          && data.projectId is string && data.projectId.size() > 0
          && data.projectTitle is string && data.projectTitle.size() > 0
          && data.preferredDate is string && data.preferredDate.size() > 0
          && data.status in ['pending', 'confirmed', 'completed', 'cancelled']
          && data.userId == request.auth.uid
          && data.createdAt == request.time;
      }

      allow create: if isVerified() && isValidVisit(incoming()) && isValidId(visitId) && incoming().status == 'pending';
      allow list, get: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() 
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNotes'])
        && incoming().status in ['pending', 'confirmed', 'completed', 'cancelled'];
    }
  }
}
